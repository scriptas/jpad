# Cloud Sync Configuration (Optional)
# Leave empty to use local-only mode

# WebDAV Server URL (e.g., https://your-synology.com:5006)
VITE_WEBDAV_URL=

# WebDAV Username
VITE_WEBDAV_USERNAME=

# WebDAV Password
VITE_WEBDAV_PASSWORD=

# Sync folder path on WebDAV server (e.g., /jpad-notes)
VITE_WEBDAV_PATH=/jpad-notes

# Auto-sync interval in seconds (0 to disable auto-sync)
VITE_SYNC_INTERVAL=300
